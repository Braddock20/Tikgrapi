APP_NAME=TikTok Automation Engine
ENVIRONMENT=development

# Required. Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
API_KEY=replace-with-a-long-random-secret

# Leave DATABASE_URL empty-ish to use SQLite locally:
DATABASE_URL=sqlite+aiosqlite:///./data/engine.db
# DATABASE_URL=postgresql+asyncpg://tiktok:tiktok_local_password@db:5432/tiktok

# Set REDIS_URL to use ARQ. Leave it empty to run the in-process worker.
REDIS_URL=
# REDIS_URL=redis://redis:6379/0

# Required for the session store:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=
SESSION_PATH=./data/session.enc
MEDIA_PATH=./data/media
WORKER_CONCURRENCY=1

# The account itself. The permanent attachment: it survives restarts,
# redeploys and expired device tokens, and it is only dead when you log out
# of TikTok yourself. Either
#
#   TIKTOK_SESSION=<paste-your-sessionid-here>
#
# (just the sessionid — the engine pairs it with the edge cookie
# tt-target-idc=alisg, without which TikTok treats you as a guest), or
#
#   TIKTOK_SESSION=sessionid=...; sessionid_ss=...; tt-target-idc=alisg; ...
#
# (the whole cookie header, which is what the browser gives you).
TIKTOK_SESSION=
# The edge cookie a bare sessionid is paired with.
TIKTOK_TARGET_IDC=alisg
# How often the session's device tokens are re-minted, in hours.
SESSION_RENEW_HOURS=6.0
# Check at boot that the account really is signed in.
SESSION_VERIFY_ON_BOOT=true

# ---------------------------------------------------------------- backend --
# auto   = start cheap, pay for the browser only when a signed request needs
#          it, and release it again when it goes idle. This is the setting
#          that fits inside Render's 512 MB free tier.
# browser = always keep the browser running
# http   = never start a browser (the few endpoints that need no signature)
BACKEND=auto
BROWSER_HEADLESS=true
# A system Chromium/Chrome to drive instead of Playwright's own download.
# Saves ~420 MB of image and ~40 MB of RAM. Examples:
#   BROWSER_EXECUTABLE_PATH=/usr/bin/chromium
#   BROWSER_EXECUTABLE_PATH=/usr/bin/google-chrome
BROWSER_EXECUTABLE_PATH=
# Release the browser this many seconds after the last signed request.
BROWSER_IDLE_SHUTDOWN_SECONDS=180
# Never start the browser when less than this much RAM is free.
BROWSER_MIN_FREE_MB=140
# The memory ceiling Chromium is told to stay under.
BROWSER_MAX_OLD_SPACE_MB=192
# Posting a comment through the page's own composer needs TikTok's React
# application to boot — about 700 MB. On a 512 MB instance there is no room
# for it, so the fallback is skipped and the reason is reported. Lower this
# only if the instance really has the memory.
UI_FALLBACK_MIN_FREE_MB=450
# The memory the whole process may use. Render's free tier is 512 MB.
MEMORY_LIMIT_MB=512

# ----------------------------------------------------------------- safety --
# Account-changing operations (like/follow/comment) stay off until enabled.
ALLOW_WRITE_OPS=false
# Conservative pacing — raise carefully, a datacenter IP talking too fast
# is the fastest way to get an account flagged.
REQUEST_MIN_INTERVAL=2.5
REQUEST_MAX_PER_HOUR=120

# -------------------------------------------------------------------- bot --
# The marker that turns a chat message into a command.
BOT_MARKER=/
# comment | dm | auto — auto prefers DM and falls back to a comment.
BOT_CHANNEL=auto
# The video whose comment thread is the chat. Empty means "use the
# account's own most recent video".
BOT_VIDEO_ID=
# Seconds between two polls of the chat channel.
BOT_POLL_INTERVAL=20
# Comma separated user ids allowed to run commands. Empty = anyone.
# Leave this empty on a shared account.
BOT_ALLOWED_AUTHORS=
# Seconds between two commands.
BOT_COOLDOWN=2
# Say hello on TikTok when the bot starts.
WELCOME_ON_BOOT=true
# Override the welcome text (empty = the built-in one).
WELCOME_TEXT=

# -------------------------------------------------------------- scheduler --
# The cron-style automation runner.
SCHEDULER_ENABLED=true

# ----------------------------------------------------------------- render --
# Ping ourselves so Render does not freeze the free instance between visits.
KEEPALIVE_ENABLED=false
KEEPALIVE_INTERVAL_SECONDS=600
